# .env.example — Copia a .env y rellena los valores
# cp .env.example .env

# Base de datos (para desarrollo local sin Docker)
DATABASE_URL=postgresql+psycopg://custodiam:TU_PASSWORD@localhost:5432/custodiam

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=custodiam
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Keycloak Admin API (EN-02-03)
# Dejar KEYCLOAK_ADMIN_PASSWORD vacío para deshabilitar la sync con
# Keycloak (alta/baja/anonimización no propagan a KC). Útil en dev y CI
# cuando no hay un Keycloak operativo todavía.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# ntfy
NTFY_URL=http://localhost:8090

# App
DEBUG=true
API_VERSION=v1

# Tests (opcional)
# Base de datos auxiliar que usan los tests. Por defecto apunta a un
# contenedor Postgres aparte en 5433 (ver guía 23).
# TEST_DATABASE_URL=postgresql+psycopg://custodiam:test@localhost:5433/custodiam_test
